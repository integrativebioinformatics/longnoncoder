/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
*/

process {
    // Ceiling applied after the task.attempt multiplier. Must stay >= the largest request below,
    // otherwise it silently clamps the labels and the numbers in this file stop meaning anything.
    // Lower it to your node size if you want it to act as a real cap.
    resourceLimits = [ cpus: 8, memory: 40.GB, time: 12.h ]

    withLabel:process_single {
        cpus   =  1
        memory = 5.GB
        time   = 4.h
    }
    withLabel:process_low {
        cpus   =  2
        memory = 3.GB
        time   = 4.h
    }
    withLabel:process_medium {
        cpus   =  8
        memory = 15.GB
        time   = 4.h
    }
    withLabel:process_high {
        cpus   =  4
        memory = 25.GB
        time   = 4.h
    }
    withLabel:process_high_memory {
        cpus = 4
        memory = 40.GB
        time = 12.h
    }
}
