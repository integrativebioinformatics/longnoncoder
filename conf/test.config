/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
----------------------------------------------------------------------------------------
*/

process {
    // Every number below is a measured peak from the execution trace of 27 Aug 2026
    // (four ONT samples) plus headroom, except where a comment says otherwise.
    //
    // Note these are STATIC requests, not the { N * task.attempt } form used in
    // base.config. A retry therefore asks for exactly the same memory as the attempt
    // that just died, so an out-of-memory failure here repeats rather than escalating.
    // That is a deliberate trade -- a test profile with a predictable footprint -- but
    // it means the first attempt has to be right, which is why the headroom below is
    // generous relative to the measurements.
    //
    // The ceiling must stay >= the largest request. Below that it silently clamps the
    // labels and the numbers in this file stop meaning anything.
    resourceLimits = [ cpus: 8, memory: 24.GB, time: 4.h ]

    // Never measured: the run this file was calibrated from died on a report syntax
    // error after 3 ms, before rendering began. Sized above process_post_refinement,
    // which draws a strict subset of the same figures and peaked at 1.7 GB.
    withLabel:process_reports {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    // The small R metadata steps. Largest measured peak was 1.1 GB
    // (ENRICH_VALIDATED_GTF); RNAmining's peak_vmem sat exactly on the old 2 GB
    // request, which is the boundary you do not want to be on. Every task under this
    // label ran between 59% and 88% CPU -- all single-threaded, so two of the three
    // cores were never used. No module here interpolates task.cpus, so dropping them
    // does not change any task hash.
    withLabel:process_low {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
    // Estimated, not measured -- no restranding task appears in the trace this was
    // sized from. Restrander streams a record at a time and inspects only the ends of
    // each read, so it should stay well under this; the I/O is comparable to Chopper's,
    // so time is sized against Chopper.
    withLabel:process_restrander {
        cpus   = 2
        memory = 4.GB
        time   = 2.h
    }
    // Measured 7.4 GB / 15m 44s on the largest sample against an 8 GB request. Chopper
    // buffers, so memory tracks input size directly: 0.6 GB of headroom is not headroom.
    withLabel:process_chopper {
        cpus   = 2
        memory = 12.GB
        time   = 2.h
    }
    // Measured 15.7 GB RSS but 17.5 GB peak_vmem -- already above the old 17 GB request
    // -- and 1h 18m against a 2 h limit. Both were one larger sample away from failing.
    // 786% of 8 cores is near-perfect scaling, so the cores stay as they are.
    withLabel:process_minimap2 {
        cpus   = 8
        memory = 22.GB
        time   = 3.h
    }
    // Measured 1.7 GB RSS / 6.8 GB vmem / 4m 48s at 247% of 3 cores.
    withLabel:process_nanocomp {
        cpus   = 3
        memory = 4.GB
        time   = 1.h
    }
    // The one number in this file that was actually wrong: measured 17.7 GB RSS and
    // 20.6 GB peak_vmem against a 15 GB request. It overran by 2.7 GB and completed
    // only because the node had memory free -- under enforced limits it is an OOM.
    // 139% CPU means 3 cores is already more than Bambu uses, and cpus must stay at 3
    // regardless: bambu/main.nf passes `-n $task.cpus`, so changing it rewrites the
    // script, changes the task hash, and throws away the cached 19-minute run.
    withLabel:process_bambu {
        cpus   = 3
        memory = 24.GB
        time   = 2.h
    }
    // Measured 1.7 GB / 40s.
    withLabel:process_post_refinement {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
    // Measured 1.2 GB / 40s. Correct as it stood.
    withLabel:process_genomic_context {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
    // Measured 1.3 GB / 55s. Correct as it stood.
    withLabel:process_validate_context {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
    // Measured 2.6 GB / 25s across four samples. The per-contig chunking holds, so this
    // comes back down from the 8 GB set defensively after the earlier OOM.
    withLabel:process_bam_coverage {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }

}
