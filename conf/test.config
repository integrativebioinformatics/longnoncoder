/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
----------------------------------------------------------------------------------------
*/

process {
    // Ceiling applied after the task.attempt multiplier. Must stay >= the largest
    // request below, otherwise it silently clamps the labels and the numbers in this
    // file stop meaning anything. Lower it to your node size for a real cap.
    resourceLimits = [ cpus: 4, memory: 18.GB, time: 2.h ]

    withLabel:process_reports {
        cpus   =  1
        memory = 5.GB
        time   = 1.h
    }
    withLabel:process_low {
        cpus   =  3
        memory = 3.GB
        time   = 1.h
    }
    withLabel:process_chopper {
        cpus   = 1
        memory = 5.GB
        time   = 2.h
    }
    withLabel:process_minimap2 {
        cpus   =  4
        memory = 12.GB
        time   = 2.h
    }
    withLabel:process_nanocomp {
        cpus   = 1
        memory = 10.GB
        time   = 1.h
    }
    withName: 'PULPOSEQ:ALIGNMENT:NANOCOMP_MAPPING' {
        cpus   =  1
        memory = 12.GB
        time   = 1.h
    }
    withLabel:process_bambu {
        cpus = 4
        memory = 18.GB
        time = 2.h
    }
}