/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running light profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [ cpus: 8, memory: 80.GB, time: 8.h ]

    withLabel:process_reports {
        cpus   =  1
        memory = 5.GB
        time   = 1.h
    }
    withLabel:process_low {
        cpus   =  3
        memory = 3.GB
        time   = 1.h
    }
    withLabel:process_chopper {
        cpus   = 1
        memory = 5.GB
        time   = 3.h
    }
    withLabel:process_minimap2 {
        cpus   =  8
        memory = 20.GB
        time   = 8.h
    }
    withLabel:process_nanocomp {
        cpus   = 1
        memory = 10.GB
        time   = 6.h
    }
    withName: 'PULPOSEQ:ALIGNMENT:NANOCOMP_MAPPING' {
        cpus   =  1
        memory = 20.GB
        time   = 8.h
    }
    withLabel:process_bambu {
        cpus = 8
        memory = 80.GB
        time = 8.h
    }
}