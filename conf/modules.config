/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

/*
    Library strandedness is derived inline, as a single expression, inside each ext.args closure.

    The strict config parser (default from Nextflow 26.04) is restrictive here: it allows only config
    assignments, blocks and includes, so top-level `def` declarations and helper functions are
    rejected, and inside a config closure it rejects statement forms such as `switch` and `return`.
    Each closure body must therefore be one expression. Do not refactor these into a shared helper or
    a switch -- both fail to parse.

    The rule itself: ONT_DRS and PacBio are always stranded; ONT_cDNA follows --stranded_library.
    stranded_library is compared as a string so a CLI-supplied "false" is not coerced to true.
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: NANOCOMP_RAW {
        ext.args   = {"--plot violin"}
        publishDir = [
            path: { "${params.outdir}/nanocomp/raw_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: NANOCOMP_FILT {
        ext.args   = {"--plot violin"}
        publishDir = [
            path: { "${params.outdir}/nanocomp/filt_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: NANOCOMP_MAPPING {
        ext.args   = {"--plot violin"}
        publishDir = [
            path: { "${params.outdir}/nanocomp/mapping" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CHOPPER {
        ext.args2   = {"-q ${params.minqual} -l ${params.minlen}${params.maxlen ? " --maxlength ${params.maxlen}" : ''} --maxgc ${params.maxgc} --mingc ${params.mingc} --headcrop ${params.headcrop} --tailcrop ${params.tailcrop}"}
        ext.prefix = {"filtered_${meta.id}"}
        publishDir = [
            path: { "${params.outdir}/chopper" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

     withName: MINIMAP2_ALIGN {
        ext.args   = {
            params.library == 'ONT_DRS' ? '-ax splice -uf -k14'
                : params.library == 'PacBio' ? '-ax splice:hq -uf'
                : params.stranded_library?.toString()?.toLowerCase() == 'true' ? '-ax splice -uf'
                : '-ax splice'
        }
        publishDir = [
            path: { "${params.outdir}/minimap2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BAMBU {
        ext.args   = {
            "--ndr ${params.ndr} --stranded ${params.library == 'ONT_DRS' || params.library == 'PacBio' || params.stranded_library?.toString()?.toLowerCase() == 'true'}"
        }
        publishDir = [
            path: { "${params.outdir}/bambu" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: GFFCOMPARE {
        ext.prefix = 'compared'  // optional: match old output filenames
        publishDir = [
            path: { "${params.outdir}/gffcompare" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: GFFREAD {
        ext.args   = "-w"
        publishDir = [
            path: { "${params.outdir}/gffread" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: RNAMINING {
        publishDir = [
            path: { "${params.outdir}/rnamining" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SUBSET_BAMBU_COUNTS {
        publishDir = [
            path: { "${params.outdir}/bambu_subset" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: NOVEL_TRANSCRIPTS {
        publishDir = [
            path: { "${params.outdir}/novel_transcripts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BAMBU_VALIDATE {
        publishDir = [
            path: { "${params.outdir}/bambu_validated" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: KNOWN_TRANSCRIPTS {
        publishDir = [
            path: { "${params.outdir}/annotated_transcripts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SUBSET_BAMBU_GTF {
        publishDir = [
            path: { "${params.outdir}/bambu_validated" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: POST_REFINEMENT {
        publishDir = [
            path: { "${params.outdir}/bambu_validated" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: RENDER_REPORT {
        publishDir = [
            path: { "${params.outdir}/transcriptome_report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
