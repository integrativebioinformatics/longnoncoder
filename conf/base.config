/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // Ceiling applied after the task.attempt multiplier, so a retry cannot request more than the
    // machine can provide. Tune these to your actual hardware, or override them in a custom config.
    resourceLimits = [ cpus: 16, memory: 160.GB, time: 16.h ]

    // TODO nf-core: Check the defaults for all processes
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    // FIXED: Put 104 in brackets so we are adding lists together
    errorStrategy = { task.exitStatus in ((130..145) + [104] + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    // FIXED: Removed quotes so it is read as an Integer, not a String
    maxErrors     = -1

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_reports {
        cpus   = { 1                   }
        memory = { 5.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 3.GB * task.attempt }
        time   = { 1.h   * task.attempt }
    }
    withLabel:process_chopper {
        cpus   = { 1     * task.attempt }
        memory = { 5.GB * task.attempt }
        time   = { 3.h   * task.attempt }
    }
    withLabel:process_minimap2 {
        cpus   = { 8    * task.attempt }
        memory = { 20.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withLabel:process_nanocomp {
        cpus   = { 1    * task.attempt }
        memory = { 10.GB * task.attempt }
        time   = { 6.h  * task.attempt }
    }
    withName: 'PULPOSEQ:ALIGNMENT:NANOCOMP_MAPPING' {
        cpus   = { 1    * task.attempt }
        memory = { 20.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withLabel:process_high_bambu {
        cpus   = { 8    * task.attempt }
        memory = { 80.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

}
