/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running large profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile for large fastq and bam files
*/

process {
    resourceLimits = [ cpus: 64, memory: 640.GB, time: 12.h ]

    withLabel:process_reports {
        cpus   =  1
        memory = 5.GB
        time   = 1.h
    }
    withLabel:process_low {
        cpus   =  3
        memory = 5.GB
        time   = 1.h
    }
    // Fixed rather than escalating, matching the rest of this profile: a retry gets
    // the same allocation, so a timeout here is fatal. 8 h is deliberately generous
    // against Chopper's measured ~2 h on 25-30 GB inputs, because the cost of being
    // wrong is losing a whole sample's worth of runtime.
    withLabel:process_restrander {
        cpus   =  2
        memory = 16.GB
        time   = 8.h
    }
    withLabel:process_chopper {
        cpus   =  2
        memory = 60.GB
        time   = 6.h
    }
    withLabel:process_minimap2 {
        cpus   = 32
        memory = 56.GB
        time   = 12.h
    }
    withLabel:process_nanocomp {
        cpus   =  3
        memory = 32.GB
        time   = 8.h
    }
    withName: 'PULPOSEQ:ALIGNMENT:NANOCOMP_MINIMAP2' {
        cpus   =  7
        memory = 80.GB
        time   = 12.h
    }
    withLabel:process_bambu {
        cpus = 64
        memory = 640.GB
        time = 12.h
    }
    withLabel:process_post_refinement {
        cpus   =  8
        memory = 80.GB
        time   = 4.h
    }
    withLabel:process_genomic_context {
        cpus   =  2
        memory = 48.GB
        time   = 4.h
    }
    withLabel:process_validate_context {
        cpus   = 4
        memory = 32.GB
        time   = 6.h
    }
    withLabel:process_bam_coverage {
        cpus   = 4
        memory = 48.GB
        time   = 6.h
    }

}