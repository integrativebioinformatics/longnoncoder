/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running large profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile for large fastq and bam files
*/

process {
    resourceLimits = [ cpus: 20, memory: 500.GB, time: 48.h ]

    withLabel:process_single {
        cpus   =  1
        memory = 5.GB
        time   = 8.h
    }
    withLabel:process_low {
        cpus   =  1
        memory = 3.GB
        time   = 4.h
    }
    withLabel:process_medium {
        cpus   =  1
        memory = 50.GB
        time   = 8.h
    }
    withLabel:process_high {
        cpus   =  20
        memory = 60.GB
        time   = 20.h
    }
    withLabel:process_long {
        time   = 48.h
    }
    withLabel:process_high_memory {
        cpus = 6
        memory = 500.GB
        time = 12.h
    }
}