/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running large profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile for large fastq and bam files
*/

process {
    resourceLimits = [ cpus: 8, memory: 600.GB, time: 12.h ]

    withLabel:process_reports {
        cpus   =  1
        memory = 5.GB
        time   = 1.h
    }
    withLabel:process_low {
        cpus   =  3
        memory = 5.GB
        time   = 1.h
    }
    withLabel:process_chopper {
        cpus   =  8
        memory = 80.GB
        time   = 8.h
    }
    withLabel:process_minimap2 {
        cpus   = 8
        memory = 80.GB
        time   = 12.h
    }
    withLabel:process_nanocomp {
        cpus   =  8
        memory = 160.GB
        time   = 12.h
    }
    withName: 'PULPOSEQ:ALIGNMENT:NANOCOMP_MAPPING' {
        cpus   =  8
        memory = 160.GB
        time   = 12.h
    }
    withLabel:process_bambu {
        cpus = 8
        memory = 512.GB
        time = 12.h
    }
    withLabel:process_post_refinement {
        cpus   =  1
        memory = 60.GB
        time   = 2.h
    }
}