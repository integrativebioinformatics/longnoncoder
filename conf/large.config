/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    integrativebioinformatics/pulposeq Nextflow config file for running large profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile for large fastq and bam files
*/

process {
    resourceLimits = [ cpus: 20, memory: 600.GB, time: 12.h ]

    withLabel:process_single {
        cpus   =  1
        memory = 5.GB
        time   = 2.h
    }
    withLabel:process_low {
        cpus   =  3
        memory = 3.GB
        time   = 2.h
    }
    withLabel:process_medium {
        cpus   =  10
        memory = 30.GB
        time   = 8.h
    }
    withLabel:process_high {
        cpus   =  20
        memory = 60.GB
        time   = 12.h
    }
    withLabel:process_high_memory {
        cpus = 8
        memory = 600.GB
        time = 12.h
    }
}